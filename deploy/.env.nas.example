# Legal Dashboard — template pentru deploy pe NAS in spatele Cloudflare Tunnel.
# Copiaza in deploy/.env.nas si completeaza. NU comite fisierul completat.
#
# Generatoare (ruleaza pe PC, nu in container):
#   JWT_SECRET                 : openssl rand -base64 48
#   PROXY_BRIDGE_SECRET        : openssl rand -base64 48
#   TENANT_KEY_SECRET          : openssl rand -base64 32   (exact 32 bytes raw)
#   OAUTH2_PROXY_COOKIE_SECRET : python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# ---- Domeniu ----------------------------------------------------------------
# Hostname-ul public rutat prin tunel, ex. dashboard.rodatagovt.com.
# Nu are nevoie de inregistrare DNS manuala: o creeaza tunelul.
DOMAIN=

# ---- Google OAuth (oauth2-proxy) --------------------------------------------
# Client creat la https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized redirect URI: https://${DOMAIN}/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domeniile de email carora li se permite login. Lasat "*" inseamna ca oricine
# cu cont Google ajunge la ecranul de login (tot nu intra fara user provizionat,
# dar e o suprafata inutila). Pentru uz personal, pune-ti adresa ta de domeniu.
OAUTH2_PROXY_EMAIL_DOMAINS=gmail.com

OAUTH2_PROXY_COOKIE_SECRET=

# ---- Backend ----------------------------------------------------------------
# Minim 32 caractere. Backend-ul refuza sa porneasca cu placeholder.
JWT_SECRET=
# Secretul comun oauth2-proxy <-> backend pentru endpointul de bridge.
PROXY_BRIDGE_SECRET=
# Exact 32 bytes raw, pentru AES-256-GCM pe cheile de tenant.
TENANT_KEY_SECRET=

# ---- Optionale --------------------------------------------------------------
APP_VERSION=2.43.3
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=

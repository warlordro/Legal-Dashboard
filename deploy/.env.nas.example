# Legal Dashboard — template pentru deploy pe NAS in spatele Cloudflare Tunnel.
# Copiaza in deploy/.env.nas si completeaza. NU comite fisierul completat.
#
# Generatoare (ruleaza pe PC, nu in container):
#   JWT_SECRET                 : openssl rand -base64 48
#   PROXY_BRIDGE_SECRET        : openssl rand -base64 48
#   TENANT_KEY_SECRET          : openssl rand -base64 32   (exact 32 bytes raw)
#   OAUTH2_PROXY_COOKIE_SECRET : python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"

# ---- Domeniu ----------------------------------------------------------------
# Hostname-ul public rutat prin tunel, ex. dashboard.rodatagovt.com.
# Nu are nevoie de inregistrare DNS manuala: o creeaza tunelul.
DOMAIN=

# ---- Google OAuth (oauth2-proxy) --------------------------------------------
# Client creat la https://console.cloud.google.com/apis/credentials
#   - Application type: Web application
#   - Authorized redirect URI: https://${DOMAIN}/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domeniile de email carora li se permite login. Lasat "*" inseamna ca oricine
# cu cont Google ajunge la ecranul de login (tot nu intra fara user provizionat,
# dar e o suprafata inutila). Pentru uz personal, pune-ti adresa ta de domeniu.
OAUTH2_PROXY_EMAIL_DOMAINS=gmail.com

OAUTH2_PROXY_COOKIE_SECRET=

# ---- Backend ----------------------------------------------------------------
# Minim 32 caractere. Backend-ul refuza sa porneasca cu placeholder.
JWT_SECRET=
# Secretul comun oauth2-proxy <-> backend pentru endpointul de bridge.
PROXY_BRIDGE_SECRET=
# Exact 32 bytes raw, pentru AES-256-GCM pe cheile de tenant.
TENANT_KEY_SECRET=

# ---- Optionale --------------------------------------------------------------
APP_VERSION=2.45.0

# Recomandat de la oauth2-proxy 7.15.2. Nesetat, proxy-ul are incredere in headerele
# X-Forwarded-* de la ORICE sursa (0.0.0.0/0) si avertizeaza la pornire — relevant
# fiindca portul 4180 e publicat pe LAN. Pune aici IP-ul sau CIDR-ul sursei pe care
# o vede efectiv pentru traficul din tunel; o valoare gresita te blocheaza afara.
# Procedura de aflare: DEPLOY-NAS.md, sectiunea din capitolul 4b.
# OAUTH2_PROXY_TRUSTED_PROXY_IPS=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_SECURE=

# Buget per incercare pe cererile catre RNPM (ms). Default in cod: 60000.
# `fetchIstoric` reincearca o data pe expirare, deci bugetul se aplica de DOUA
# ori pe o cerere agatata, iar cele 12 cereri dintr-o transa de detalii asteapta
# impreuna — un singur istoric agatat tine in loc 12 avize.
# Masurat pe productie (2026-08-02, aceeasi cautare de 144 de rezultate):
# la 60000 -> 100 avize in 7m 4s (2,9 s/aviz); la 25000 -> 144 avize in 2m 43s
# (1,1 s/aviz, cu tot cu captcha). Nicio pierdere de avize in niciunul din cazuri.
RNPM_TIMEOUT_MS=25000

# Plafon wall-clock pe trecerea de recuperare a detaliilor (ms). Default 120000;
# 0 dezactiveaza complet recuperarea.
RNPM_RECOVERY_BUDGET_MS=
